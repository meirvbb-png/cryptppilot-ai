# העתק לקובץ בשם .env (הקובץ .env לא נשמר ב-Git)

# קוד גישה לאפליקציה (מומלץ מאוד, כי השרת מאזין לכל הרשת המקומית)
APP_TOKEN=change-me-to-a-long-random-code

PORT=8000
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# ---- מסחר חי: כבוי. אל תשנה בלי החלטה מפורשת ----
BYBIT_LIVE_ENABLED=false
# demo = חשבון הדמו של Bybit (api-demo.bybit.com) | mainnet = כסף אמיתי
BYBIT_ENV=demo
# מפתח עם הרשאות Contract Orders/Positions בלבד, בלי Withdraw (המערכת חוסמת מפתח עם הרשאת משיכה)
BYBIT_API_KEY=
BYBIT_API_SECRET=
